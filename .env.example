# ── IQ-Hybrid Engine Configuration ──
# Copy this file to .env and fill in the values.

# Path to the llama-quantize binary (required for --run and dry-run).
# Accepts both forward slashes and backslashes on Windows.
# Example (Windows): C:\Users\YourName\llama.cpp\build\bin\Release\llama-quantize.exe
# Example (Linux):   /usr/local/bin/llama-quantize
LLAMA_QUANTIZE_PATH=

# Default output directory for quantized GGUF files (optional).
# If unset, quantized files are written to the current working directory.
OUTPUT_DIR=.\Models